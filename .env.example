# Modalflow local development environment
# Copy to your Airflow project directory as .env and customize values.
# Then: source .env && airflow standalone

AIRFLOW_HOME=.
AIRFLOW__CORE__EXECUTOR=modalflow.executor.ModalExecutor
AIRFLOW__CORE__DAGS_FOLDER=./dags
AIRFLOW__CORE__LOAD_EXAMPLES=false

# Required: URL where Modal functions can reach your Airflow execution API.
# For local dev, use a reverse tunnel (ngrok, Cloudflare Tunnel, etc.)
# The /execution/ suffix is required — the Airflow task SDK uses relative paths.
# AIRFLOW__CORE__EXECUTION_API_SERVER_URL=https://your-tunnel-url.ngrok-free.app/execution/
