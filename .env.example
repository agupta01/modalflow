# Modalflow local development environment
# Copy to your Airflow project directory as .env and customize values.
# Then: source .env && airflow standalone

AIRFLOW_HOME=.
AIRFLOW__CORE__EXECUTOR=modalflow.executor.ModalExecutor
AIRFLOW__CORE__DAGS_FOLDER=./dags
AIRFLOW__CORE__LOAD_EXAMPLES=false

# Required: the Modal Volume the executor mounts into each task sandbox.
# Push your DAGs to it first: modalflow sync --dags-path ./dags --dags-volume my-dags
MODALFLOW_DAGS_VOLUME=my-dags

# Optional: target Modal environment name (default: main).
# MODALFLOW_ENV=main

# Optional: Airflow version installed in each task sandbox (default: 3.1.5).
# Set this to match your Airflow server version to avoid API version mismatches.
# MODALFLOW_AIRFLOW_VERSION=3.1.5

# Required: URL where task sandboxes can reach your Airflow execution API.
# For local dev, use a reverse tunnel (ngrok, Cloudflare Tunnel, etc.)
# The /execution/ suffix is required — the Airflow task SDK uses relative paths.
# AIRFLOW__CORE__EXECUTION_API_SERVER_URL=https://your-tunnel-url.ngrok-free.app/execution/
